<Window x:Class="Countdown.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カウントダウン 表示"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseLeftButtonDown="DragDisplay">
  <Viewbox>
    <Grid x:Name="DisplayContent" Width="334" Height="110" Background="Transparent"
          TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
      <Border x:Name="Backdrop" Background="#151C26" CornerRadius="19" />
      <TextBlock x:Name="TimeText" FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold"
                 VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="SizeAll" />
    </Grid>
  </Viewbox>
</Window>
